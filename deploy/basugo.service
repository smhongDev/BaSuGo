[Unit]
Description=BaSuGo (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=basugo
Group=basugo
WorkingDirectory=/opt/basugo/app
EnvironmentFile=/etc/basugo/env
Environment=HOME=/opt/basugo
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3001
Restart=always
RestartSec=3
TimeoutStopSec=20

# 보안: 쓰기는 빌드 캐시 폴더와 상태 폴더만.
# 방문자 기록은 각자의 브라우저에 있고, 서버에는 공지·기준값·알림 구독만 /var/lib/basugo 에 JSON 으로 둔다.
StateDirectory=basugo
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/basugo/app/.next
ReadOnlyPaths=/opt/basugo
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
