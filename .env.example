# 개발 중 외부 API 없이 화면을 확인하려면 1 (운영에서는 쓰지 않는다)
# BASUGO_MOCK=1

# 공공데이터포털 인증키: 기상청 기상특보 + 국립해양조사원 조석예보 (없으면 Open-Meteo 값만 사용)
# DATA_GO_KR_KEY=

# 관리자 로그인 (/admin). 운영 서버에서는 setup-server.sh 가 /etc/basugo/env 에 자동으로 만든다.
# ADMIN_USER=admin
# ADMIN_PASSWORD=

# 알림 검사 타이머가 /api/alerts/run 을 부를 때 쓰는 비밀값 (16자 이상)
# ALERT_SECRET=

# 상태 파일 폴더 (기본: 운영 /var/lib/basugo, 개발 ./.data)
# BASUGO_STATE_DIR=
